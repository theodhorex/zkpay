# ZKPay (ZecSub) Environment Configuration
# Copy this file to .env.local for local overrides: cp .env.example .env.local

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Local SQLite / LibSQL file (default for local dev)
DATABASE_URL="file:./zkpay.db"

# Option 2: Online Cloud LibSQL (Turso)
# DATABASE_URL="libsql://your-database-name.turso.io"
# DATABASE_AUTH_TOKEN="eyJhbGciOi..."

# ==============================================================================
# Zcash Network & Lightwalletd Node
# ==============================================================================
# Default Testnet node
ZCASH_LIGHTWALLETD_URL="testnet.zec.rocks:443"

# For Mainnet:
# ZCASH_LIGHTWALLETD_URL="mainnet.lightwalletd.com:9067"

# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=""

# Secret token for authenticating webhook requests (optional, recommended for production)
TELEGRAM_WEBHOOK_SECRET="zkpay_secret_token_change_me"

# Public application base URL (e.g. https://your-domain.com or ngrok URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
